# ランタイム生成ディレクトリ (ProjFS 投影 / ファイル転送の保存先)
# 起動時 CWD 次第で任意階層に作られるためアンカーしない
aurora-remote/
aurora-received/
aurora-downloads/
# インストーラのビルド成果物 (host ISCC 出力 + client NSIS のコピー)
installer/dist/
# VDD ドライバファイル (build.ps1 がビルド時にコピー、バイナリなので git 管理しない)
installer/host/vdd/

# フロントの目視確認ハーネス (Tauri なしでブラウザ検証する一時ページ。コミットしない)
crates/client/src/dev-*.ts
crates/client/src/dev-*.html
